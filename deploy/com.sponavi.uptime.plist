<?xml version="1.0" encoding="UTF-8"?>
<!-- 스포내비 업타임 프로브 — 맥 launchd, 5분 주기. 설치:
     cp deploy/com.sponavi.uptime.plist ~/Library/LaunchAgents/ && launchctl load -w ~/Library/LaunchAgents/com.sponavi.uptime.plist
     해제: launchctl unload -w ~/Library/LaunchAgents/com.sponavi.uptime.plist
     ProgramArguments 의 스크립트 경로는 리포 위치에 맞게 수정. 맥이 잠들면 공백이 생긴다(README 참조). -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.sponavi.uptime</string>
  <key>ProgramArguments</key><array>
    <string>/bin/bash</string>
    <string>/Users/kyuchan/sponavi/scripts/uptime_probe.sh</string>
  </array>
  <key>EnvironmentVariables</key><dict>
    <key>SPONAVI_PROBE_URL</key><string>https://sponavi.kro.kr/api/health</string>
    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
  </dict>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardErrorPath</key><string>/tmp/sponavi-uptime.err</string>
</dict></plist>
